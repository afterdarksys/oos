{
  "version": 1,
  "volume": "/System/Volumes/Data",
  "policy": {
    "min_free_gb": 50,
    "warn_free_gb": 100,
    "require_yes": true,
    "max_delete_gb_per_run": 200,
    "allow_outside_home": false,
    "allow_commands": true,
    "never_touch": [
      "/",
      "/System",
      "/Library",
      "/Applications",
      "~/development",
      "~/Documents",
      "~/Desktop",
      "~/Pictures",
      "~/Movies",
      "~/Music",
      "~/Virtual Machines.localized",
      "~/.ssh",
      "~/.gnupg",
      "~/.claude",
      "~/Library/Containers/com.docker.docker/Data/vms"
    ],
    "min_path_depth": 3,
    "log_file": "~/.local/state/oos/oos.log",
    "state_file": "~/.local/state/oos/bigfile.json",
    "big_file_min_mb": 500,
    "scan_top_n": 50,
    "quarantine": true,
    "quarantine_dir": "~/.local/state/oos/quarantine",
    "quarantine_days": 7,
    "owners": [
      {
        "match": "~/.local/state/oos",
        "use_case": "oos quarantine and state"
      },
      {
        "match": "~/development/**/src-tauri/target",
        "use_case": "Rust build output",
        "note": "Tauri desktop apps; cargo clean by hand"
      },
      {
        "match": "~/development/**/target",
        "use_case": "Rust build output"
      },
      {
        "match": "~/development/**/node_modules",
        "use_case": "npm dependencies"
      },
      {
        "match": "~/development/**/.next",
        "use_case": "Next.js build output"
      },
      {
        "match": "~/development",
        "use_case": "source trees"
      },
      {
        "match": "~/.cache/uv",
        "use_case": "uv / MCP servers for Claude sessions",
        "note": "code-review-graph, blender-mcp; regrows ~1 GB/h while sessions run"
      },
      {
        "match": "~/Library/Containers/com.docker.docker",
        "use_case": "Docker Desktop"
      },
      {
        "match": "/Library/Developer/CoreSimulator",
        "use_case": "Xcode simulators"
      },
      {
        "match": "~/Library/Developer/Xcode",
        "use_case": "Xcode build output"
      },
      {
        "match": "~/Virtual Machines.localized",
        "use_case": "VM images"
      },
      {
        "match": "~/.codex",
        "use_case": "Codex sessions"
      },
      {
        "match": "~/.claude",
        "use_case": "Claude Code"
      },
      {
        "match": "~/tmp",
        "use_case": "Claude Code scratchpads"
      },
      {
        "match": "~/go",
        "use_case": "Go modules and tools"
      },
      {
        "match": "~/.npm",
        "use_case": "npm cache"
      },
      {
        "match": "~/Library/Caches/Homebrew",
        "use_case": "Homebrew cache"
      },
      {
        "match": "~/Downloads",
        "use_case": "downloads, unreviewed"
      },
      {
        "match": "~/.colima",
        "use_case": "Colima VM (old Docker alternative)"
      },
      {
        "match": "~/.minikube",
        "use_case": "minikube VM"
      },
      {
        "match": "~/.rustup",
        "use_case": "Rust toolchains"
      },
      {
        "match": "~/.cargo",
        "use_case": "Cargo registry"
      },
      {
        "match": "~/.nvm",
        "use_case": "Node versions (nvm)"
      },
      {
        "match": "~/.bun",
        "use_case": "Bun runtime"
      },
      {
        "match": "~/.pub-cache",
        "use_case": "Dart/Flutter packages"
      },
      {
        "match": "~/.terraform.d",
        "use_case": "Terraform plugins"
      },
      {
        "match": "~/.vscode",
        "use_case": "VS Code extensions"
      },
      {
        "match": "~/.cursor",
        "use_case": "Cursor editor"
      },
      {
        "match": "~/.windsurf",
        "use_case": "Windsurf editor"
      },
      {
        "match": "~/.antigravity",
        "use_case": "Antigravity IDE"
      },
      {
        "match": "~/.antigravity-ide",
        "use_case": "Antigravity IDE"
      },
      {
        "match": "~/.gemini",
        "use_case": "Gemini CLI"
      },
      {
        "match": "~/.agents",
        "use_case": "agent skills"
      },
      {
        "match": "~/kaggle-data",
        "use_case": "Kaggle datasets"
      }
    ],
    "agent_purge_expired": true,
    "alert_drop_gb": 10,
    "size_cache_file": "~/.local/state/oos/sizes.json",
    "size_cache_hours": 6,
    "reference_open_files": true,
    "fleet": [
      "root@relay-b",
      "root@apps.afterdarksys.com"
    ],
    "fleet_timeout_seconds": 20
  },
  "known_dirs": [
    {
      "path": "~/.cache/uv/archive-v0",
      "type": "cache",
      "action": "rm-stale-children",
      "stale_after_hours": 6,
      "note": "uv ephemeral tool environments; the leak (155 GB on 2026-09-07). Live MCP servers run from here. Children referenced by any running process's command line or cwd are kept, as are children touched in the last 6 hours; the rest go to quarantine."
    },
    {
      "path": "~/.cache/uv/sdists-v9",
      "type": "cache",
      "action": "rm-contents",
      "note": "uv source-dist download cache, regenerates"
    },
    {
      "path": "~/.cache/uv/builds-v0",
      "type": "cache",
      "action": "rm-contents",
      "note": "uv build cache, regenerates"
    },
    {
      "path": "~/.cache/uv/wheels-v6",
      "type": "cache",
      "action": "rm-contents",
      "note": "uv wheel cache, regenerates"
    },
    {
      "path": "~/Library/Caches/Homebrew",
      "type": "cache",
      "action": "rm-contents",
      "note": "brew download cache. Contains a read-only go_mod_cache; oos chmods before removing."
    },
    {
      "path": "~/Library/Caches/go-build",
      "type": "cache",
      "action": "command",
      "command": "go clean -cache",
      "note": "Go build cache, regenerates on next build"
    },
    {
      "path": "~/go/pkg/mod",
      "type": "cache",
      "action": "command",
      "command": "go clean -modcache",
      "note": "Go module cache, re-downloads on next build. Read-only files, so use the go tool."
    },
    {
      "path": "~/.npm/_cacache",
      "type": "cache",
      "action": "command",
      "command": "npm cache clean --force",
      "note": "npm content cache"
    },
    {
      "path": "~/Library/Caches/pip",
      "type": "cache",
      "action": "rm-contents",
      "note": "pip download cache"
    },
    {
      "path": "~/Library/Developer/Xcode/DerivedData",
      "type": "build",
      "action": "rm-contents",
      "guard_processes": [
        "Xcode.app/Contents/MacOS/Xcode",
        "xcodebuild"
      ],
      "note": "Xcode build products, regenerates"
    },
    {
      "path": "~/development/gomeow.media/desktop/src-tauri/target",
      "type": "build",
      "action": "never",
      "note": "Rust debug target, 28 GB on 2026-09-08. Under ~/development so never automated; cargo clean by hand when the other session is idle."
    },
    {
      "path": "~/development/afteredit/src-tauri/target",
      "type": "build",
      "action": "never",
      "note": "Rust debug target. Same rule as above."
    },
    {
      "path": "/Library/Developer/CoreSimulator",
      "type": "sim",
      "action": "command",
      "command": "xcrun simctl delete unavailable",
      "note": "Simulator runtimes are mounted volumes, never rm. simctl removes only unavailable ones."
    },
    {
      "path": "~/Library/Containers/com.docker.docker/Data/vms/0/data",
      "type": "vm",
      "action": "command",
      "command": "docker builder prune -f && docker image prune -f",
      "note": "Docker VM disk. Never rm; ask the daemon to prune. Shrink Docker.raw via Docker Desktop settings."
    },
    {
      "path": "~/.codex",
      "type": "data",
      "action": "never",
      "note": "Codex session logs and sqlite; near 1 GB and growing. Review by hand."
    },
    {
      "path": "~/tmp",
      "type": "scratch",
      "action": "never",
      "note": "Claude Code scratchpads. Sessions may be live; clean by hand."
    },
    {
      "path": "~/Virtual Machines.localized",
      "type": "vm",
      "action": "never",
      "note": "VM images, user data"
    },
    {
      "path": "~/Downloads",
      "type": "data",
      "action": "never",
      "note": "User data, review by hand"
    },
    {
      "path": "~/development",
      "type": "data",
      "action": "never",
      "note": "Source trees, never automated"
    },
    {
      "path": "~/Library/Developer/CoreSimulator/Devices",
      "type": "sim",
      "action": "command",
      "command": "xcrun simctl delete unavailable",
      "use_case": "Xcode simulators",
      "tags": [
        "xcode"
      ],
      "note": "simulator devices; the command removes only devices whose runtime is gone"
    },
    {
      "path": "~/Library/Developer/Xcode/iOS DeviceSupport",
      "type": "cache",
      "action": "rm-contents",
      "use_case": "Xcode build output",
      "tags": [
        "xcode"
      ],
      "note": "per-device symbol files, re-downloaded from the device on the next connect"
    },
    {
      "path": "~/Library/Developer/Xcode/Archives",
      "type": "data",
      "action": "never",
      "use_case": "Xcode build output",
      "tags": [
        "xcode"
      ],
      "note": "App Store and ad hoc archives; delete from the Organizer by hand"
    },
    {
      "path": "~/Library/Application Support/MobileSync/Backup",
      "type": "data",
      "action": "never",
      "use_case": "iOS device backups",
      "tags": [
        "backups"
      ],
      "note": "iPhone and iPad backups; Finder > device > Manage Backups"
    }
  ],
  "known_files": [
    {
      "path": "~/Library/Containers/com.docker.docker/Data/vms/0/data/Docker.raw",
      "type": "vm",
      "action": "never",
      "note": "Docker VM disk image, sparse. Apparent size is the configured cap, not usage."
    }
  ]
}
