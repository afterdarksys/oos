{
  "version": 1,
  "volume": "/System/Volumes/Data",
  "policy": {
    "min_free_gb": 50,
    "warn_free_gb": 100,
    "require_yes": true,
    "max_delete_gb_per_run": 200,
    "allow_outside_home": false,
    "allow_commands": true,
    "never_touch": [
      "/",
      "/System",
      "/Library",
      "/Applications",
      "~/development",
      "~/Documents",
      "~/Desktop",
      "~/Pictures",
      "~/Movies",
      "~/Music",
      "~/Virtual Machines.localized",
      "~/.ssh",
      "~/.gnupg",
      "~/.claude",
      "~/Library/Containers/com.docker.docker/Data/vms"
    ],
    "min_path_depth": 3,
    "log_file": "~/.local/state/oos/oos.log",
    "state_file": "~/.local/state/oos/bigfile.json",
    "big_file_min_mb": 500,
    "scan_top_n": 50
  },
  "known_dirs": [
    {
      "path": "~/.cache/uv/archive-v0",
      "type": "cache",
      "action": "rm-contents",
      "guard_processes": ["uvx", "uv tool", "code-review-graph", "blender-mcp"],
      "note": "uv ephemeral tool environments. This is the leak (155 GB on 2026-09-07). Live MCP servers run from here; refuse while any are up."
    },
    {
      "path": "~/.cache/uv/sdists-v9",
      "type": "cache",
      "action": "rm-contents",
      "note": "uv source-dist download cache, regenerates"
    },
    {
      "path": "~/.cache/uv/builds-v0",
      "type": "cache",
      "action": "rm-contents",
      "note": "uv build cache, regenerates"
    },
    {
      "path": "~/.cache/uv/wheels-v6",
      "type": "cache",
      "action": "rm-contents",
      "note": "uv wheel cache, regenerates"
    },
    {
      "path": "~/Library/Caches/Homebrew",
      "type": "cache",
      "action": "rm-contents",
      "note": "brew download cache. Contains a read-only go_mod_cache; oos chmods before removing."
    },
    {
      "path": "~/Library/Caches/go-build",
      "type": "cache",
      "action": "command",
      "command": "go clean -cache",
      "note": "Go build cache, regenerates on next build"
    },
    {
      "path": "~/go/pkg/mod",
      "type": "cache",
      "action": "command",
      "command": "go clean -modcache",
      "note": "Go module cache, re-downloads on next build. Read-only files, so use the go tool."
    },
    {
      "path": "~/.npm/_cacache",
      "type": "cache",
      "action": "command",
      "command": "npm cache clean --force",
      "note": "npm content cache"
    },
    {
      "path": "~/Library/Caches/pip",
      "type": "cache",
      "action": "rm-contents",
      "note": "pip download cache"
    },
    {
      "path": "~/Library/Developer/Xcode/DerivedData",
      "type": "build",
      "action": "rm-contents",
      "guard_processes": ["Xcode.app/Contents/MacOS/Xcode", "xcodebuild"],
      "note": "Xcode build products, regenerates"
    },
    {
      "path": "/Library/Developer/CoreSimulator",
      "type": "sim",
      "action": "command",
      "command": "xcrun simctl delete unavailable",
      "note": "Simulator runtimes are mounted volumes, never rm. simctl removes only unavailable ones."
    },
    {
      "path": "~/Library/Containers/com.docker.docker/Data/vms/0/data",
      "type": "vm",
      "action": "command",
      "command": "docker builder prune -f && docker image prune -f",
      "note": "Docker VM disk. Never rm; ask the daemon to prune. Shrink Docker.raw via Docker Desktop settings."
    },
    {
      "path": "~/tmp",
      "type": "scratch",
      "action": "never",
      "note": "Claude Code scratchpads. Sessions may be live; clean by hand."
    },
    {
      "path": "~/Virtual Machines.localized",
      "type": "vm",
      "action": "never",
      "note": "VM images, user data"
    },
    {
      "path": "~/Downloads",
      "type": "data",
      "action": "never",
      "note": "User data, review by hand"
    },
    {
      "path": "~/development",
      "type": "data",
      "action": "never",
      "note": "Source trees, never automated"
    }
  ],
  "known_files": [
    {
      "path": "~/Library/Containers/com.docker.docker/Data/vms/0/data/Docker.raw",
      "type": "vm",
      "action": "never",
      "note": "Docker VM disk image, sparse. Apparent size is the configured cap, not usage."
    }
  ]
}
